<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/profileScroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/profile_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size"
                        android:layout_height="@dimen/avatar_size">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@color/md_primary"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.GreenBasket.Circle" />

                        <TextView
                            android:id="@+id/avatarInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="AM" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_name"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Headline"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_phone"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_accent_pill"
                            android:paddingHorizontal="@dimen/space_s"
                            android:paddingVertical="2dp"
                            android:text="@string/profile_member_badge"
                            android:textColor="@color/on_accent_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statOrders"
                    style="@style/ProfileStatCard"
                    android:layout_marginEnd="@dimen/space_s">

                    <LinearLayout style="@style/ProfileStatContent">

                        <TextView
                            android:id="@+id/statOrdersValue"
                            style="@style/ProfileStatValue"
                            tools:text="4" />

                        <TextView
                            style="@style/ProfileStatLabel"
                            android:text="@string/profile_stat_orders" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statSavings"
                    style="@style/ProfileStatCard"
                    android:layout_marginEnd="@dimen/space_s">

                    <LinearLayout style="@style/ProfileStatContent">

                        <TextView
                            android:id="@+id/statSavingsValue"
                            style="@style/ProfileStatValue"
                            android:textColor="@color/price_green"
                            tools:text="₹312" />

                        <TextView
                            style="@style/ProfileStatLabel"
                            android:text="@string/profile_stat_saved" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statWishlist"
                    style="@style/ProfileStatCard">

                    <LinearLayout style="@style/ProfileStatContent">

                        <TextView
                            android:id="@+id/statWishlistValue"
                            style="@style/ProfileStatValue"
                            tools:text="7" />

                        <TextView
                            style="@style/ProfileStatLabel"
                            android:text="@string/profile_stat_wishlist" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Addresses -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SheetSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/profile_addresses" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addAddressButton"
                    style="@style/Widget.GreenBasket.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/address_add_new"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/addressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Settings -->
            <TextView
                style="@style/SheetSectionTitle"
                android:text="@string/profile_settings" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowWishlist"
                        style="@style/ProfileRow">

                        <ImageView
                            style="@style/ProfileRowIcon"
                            android:src="@drawable/ic_favorite_border" />

                        <TextView
                            style="@style/ProfileRowTitle"
                            android:text="@string/title_wishlist" />

                        <ImageView
                            style="@style/ProfileRowChevron"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowTheme"
                        style="@style/ProfileRow">

                        <ImageView
                            style="@style/ProfileRowIcon"
                            android:src="@drawable/ic_dark_mode" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_appearance"
                                android:textAppearance="@style/TextAppearance.GreenBasket.Body" />

                            <TextView
                                android:id="@+id/themeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.GreenBasket.Caption"
                                tools:text="System default" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ProfileRowChevron"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowAbout"
                        style="@style/ProfileRow">

                        <ImageView
                            style="@style/ProfileRowIcon"
                            android:src="@drawable/ic_info" />

                        <TextView
                            style="@style/ProfileRowTitle"
                            android:text="@string/profile_about" />

                        <ImageView
                            style="@style/ProfileRowChevron"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:layout_marginBottom="@dimen/space_l"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.GreenBasket.Caption"
                tools:text="GreenBasket v1.0.0" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
