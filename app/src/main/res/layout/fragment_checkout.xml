<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/checkoutScroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_navigate_up"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_checkout" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/checkoutScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Delivery address -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Title"
                            tools:text="Delivering to Home" />

                        <TextView
                            android:id="@+id/addressLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Caption"
                            tools:text="Flat 1204, Lotus Residency, Hiranandani Gardens, Powai, Mumbai - 400076" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeAddressButton"
                        style="@style/Widget.GreenBasket.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_change" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery slot -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:id="@+id/slotIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_delivery_slot"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Caption" />

                        <TextView
                            android:id="@+id/slotLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Title"
                            tools:text="Express · 15 mins" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeSlotButton"
                        style="@style/Widget.GreenBasket.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_change" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order summary -->
            <TextView
                style="@style/SheetSectionTitle"
                android:text="@string/checkout_order_summary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/summaryItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_l"
                    android:paddingVertical="@dimen/space_s" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment -->
            <TextView
                style="@style/SheetSectionTitle"
                android:text="@string/checkout_payment" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/paymentGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_s"
                    android:paddingVertical="@dimen/space_xs">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/payUpi"
                        style="@style/PaymentOption"
                        android:text="@string/payment_upi"
                        app:drawableEndCompat="@drawable/ic_wallet" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/payCard"
                        style="@style/PaymentOption"
                        android:text="@string/payment_card"
                        app:drawableEndCompat="@drawable/ic_payment" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/payCash"
                        style="@style/PaymentOption"
                        android:text="@string/payment_cash"
                        app:drawableEndCompat="@drawable/ic_delivery" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <include
                    android:id="@+id/bill"
                    layout="@layout/layout_bill_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_l" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/checkout_demo_note"
                android:textAppearance="@style/TextAppearance.GreenBasket.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/placeOrderBar"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp">

        <FrameLayout
            android:id="@+id/placeOrderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/placeOrderButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                tools:text="Place order · ₹356" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/placingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorOnPrimary"
                app:indicatorSize="28dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
