<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_header_height"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:collapsedTitleTextAppearance="@style/TextAppearance.GreenBasket.ToolbarTitle"
            app:contentScrim="?attr/colorSurfaceContainerLowest"
            app:expandedTitleTextAppearance="@style/TextAppearance.GreenBasket.ExpandedTitleHidden"
            app:expandedTitleTextColor="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:maxLines="1"
            app:scrimAnimationDuration="250"
            app:titleCollapseMode="fade">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5">

                <TextView
                    android:id="@+id/heroEmoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textSize="@dimen/detail_emoji_size"
                    tools:text="🥛" />

                <TextView
                    android:id="@+id/heroDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/screen_padding"
                    android:background="@drawable/bg_discount_badge"
                    android:paddingHorizontal="@dimen/space_s"
                    android:paddingVertical="@dimen/space_xs"
                    android:textColor="@color/discount_badge_text"
                    android:textStyle="bold"
                    tools:text="18% OFF" />
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:menu="@menu/menu_product_detail"
                app:navigationContentDescription="@string/cd_navigate_up"
                app:navigationIcon="@drawable/ic_arrow_back" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding">

                <TextView
                    android:id="@+id/brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.GreenBasket.Label"
                    android:textColor="?attr/colorPrimary"
                    tools:text="DailyGold" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.GreenBasket.Headline"
                    tools:text="Toned Milk" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rating_pill"
                        android:drawablePadding="2dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_star_small"
                        tools:text="4.5" />

                    <TextView
                        android:id="@+id/ratingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.GreenBasket.Caption"
                        tools:text="2,341 ratings" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GreenBasket.Price.Large"
                        tools:text="₹54" />

                    <TextView
                        android:id="@+id/mrp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_marginBottom="3dp"
                        android:textAppearance="@style/TextAppearance.GreenBasket.Mrp"
                        android:textSize="14sp"
                        tools:text="MRP ₹60" />

                    <TextView
                        android:id="@+id/discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_marginBottom="3dp"
                        android:textColor="@color/price_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="10% OFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_inclusive_taxes"
                    android:textAppearance="@style/TextAppearance.GreenBasket.Caption" />

                <TextView
                    android:id="@+id/variantsTitle"
                    style="@style/SheetSectionTitle"
                    android:text="@string/detail_select_unit" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/variantGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.GreenBasket.Card.Flat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:id="@+id/deliveryInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_m"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Body"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_bolt_header"
                            tools:text="Delivery in 15 minutes" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:drawablePadding="@dimen/space_m"
                            android:gravity="center_vertical"
                            android:text="@string/detail_free_delivery_note"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Body.Muted"
                            app:drawableStartCompat="@drawable/ic_delivery_small" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:drawablePadding="@dimen/space_m"
                            android:gravity="center_vertical"
                            android:text="@string/detail_quality_note"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Body.Muted"
                            app:drawableStartCompat="@drawable/ic_verified_small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SheetSectionTitle"
                    android:text="@string/detail_highlights" />

                <LinearLayout
                    android:id="@+id/highlightsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/SheetSectionTitle"
                    android:text="@string/detail_description" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.GreenBasket.Body.Muted"
                    tools:text="Pasteurised toned milk with 3% fat." />

                <LinearLayout
                    android:id="@+id/nutritionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SheetSectionTitle"
                        android:text="@string/detail_nutrition" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/nutritionTable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/space_l"
                            android:paddingVertical="@dimen/space_s" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/similarTitle"
                style="@style/SheetSectionTitle"
                android:layout_marginTop="@dimen/space_xxl"
                android:paddingHorizontal="@dimen/screen_padding"
                android:text="@string/detail_similar" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/similarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_s" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        style="@style/Widget.Material3.CardView.Elevated"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

        <LinearLayout
            android:id="@+id/bottomBarContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/viewCartRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="?attr/colorPrimaryContainer"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                android:visibility="gone">

                <TextView
                    android:id="@+id/viewCartText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_cart_small"
                    tools:text="3 items in cart" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:text="@string/action_view_cart"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold"
                    app:drawableEndCompat="@drawable/ic_chevron_right_small" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/bottom_bar_min_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingVertical="@dimen/space_m">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/barPack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GreenBasket.Caption"
                        tools:text="1 L" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/barPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Price"
                            android:textSize="18sp"
                            tools:text="₹54" />

                        <TextView
                            android:id="@+id/barMrp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginBottom="2dp"
                            android:textAppearance="@style/TextAppearance.GreenBasket.Mrp"
                            tools:text="₹60" />
                    </LinearLayout>
                </LinearLayout>

                <io.github.ieswar23.greenbasket.ui.common.QuantityStepperView
                    android:id="@+id/barStepper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:stepperSize="large" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
