<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SheetSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.GreenBasket.Title</item>
    </style>
    <style name="PaymentOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.GreenBasket.Body</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="DetailInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.GreenBasket.Body</item>
        <item name="drawableTint">?attr/colorPrimary</item>
    </style>
</resources>
