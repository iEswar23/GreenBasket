<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="120dp"
            android:height="120dp"
            android:viewportWidth="52"
            android:viewportHeight="52">
            <path
                android:name="circle"
                android:fillColor="#00000000"
                android:pathData="M26,3 A23,23 0 1,1 25.99,3"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="check"
                android:fillColor="#00000000"
                android:pathData="M15,27 L22.5,34.5 L37.5,19"
                android:strokeWidth="4"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathEnd="0" />
        </vector>
    </aapt:attr>
    <target android:name="circle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="520"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
